{
  "uid": "roomlock",
  "title": "RoomLock",
  "description": "The hold flow by locking strategy (D2): throughput, p95/p99 of one attempt, the busy and contended outcomes, retried attempts, then the outbox backlog and what it publishes, the charges and refunds of payment-service, and below them the HikariCP pool and the JVM of the selected service.",
  "tags": [
    "roomlock"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(service)",
        "query": "label_values(service)",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {
          "selected": false,
          "text": "booking-service",
          "value": "booking-service"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Holds",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Holds per second by strategy",
      "description": "Rate of finished holds, whatever they answered: the throughput of the flow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "sum by (strategy) (rate(roomlock_hold_outcomes_total{service=\"$service\"}[1m]))",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hold attempt latency by strategy",
      "description": "p95 and p99 of one attempt, from the histogram of roomlock.hold.attempts. A retried hold contributes one sample per attempt.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(roomlock_hold_attempts_seconds_bucket{service=\"$service\"}[1m])))",
          "legendFormat": "{{strategy}} p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(roomlock_hold_attempts_seconds_bucket{service=\"$service\"}[1m])))",
          "legendFormat": "{{strategy}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Conflicts per second by strategy",
      "description": "busy is a room a night of the stay is already taken in; contended is a hold that lost every race it was allowed to run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
