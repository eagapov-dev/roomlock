// Copy to terraform.tfvars and fill in project_id. Everything else has a default that is correct for
// a one-off verification run.
//
//   cp terraform.tfvars.example terraform.tfvars
//
// There is no secret in this file and there must never be one. The database password is generated by
// Terraform and stored in Secret Manager; nothing here is a credential.

// The only value with no default.
project_id = "roomlock-demo-123456"

// ---------------------------------------------------------------------------
// Everything below is optional — shown with its default, uncomment to change.
// ---------------------------------------------------------------------------

// region      = "europe-west1"
// environment = "dev"

// Cloud SQL. db-g1-small is shared-core and outside the Cloud SQL SLA, which is the right trade for a
// throwaway; db-custom-1-3840 is the smallest tier with SLA coverage.
// sql_tier                   = "db-g1-small"
// sql_disk_size_gb           = 10
// sql_availability_type      = "ZONAL"
// sql_point_in_time_recovery = false

// Managed Kafka. All three of these are already at the floor the API enforces — 3 vCPU, 1 GiB per
// vCPU, 100 GiB of disk per broker. There is no smaller cluster to ask for.
// kafka_vcpu_count           = 3
// kafka_memory_gib           = 3
// kafka_broker_disk_size_gib = 100
// kafka_partitions           = 3
// kafka_replication_factor   = 3

// Cloud Run. 512Mi is the platform floor at 1 CPU, but see the variable's description before using it.
// service_cpu        = "1"
// service_memory     = "1Gi"
// max_instance_count = 1
// image_tag          = "dev"

// FALSE by default, and that is deliberate: booking-service authenticates nothing itself, so making it
// public puts a bookable API on the open internet. Prefer naming callers below.
// booking_service_public = false

// Who may call booking-service while it is not public. Each caller sends
//   Authorization: Bearer $(gcloud auth print-identity-token)
// booking_invoker_members = [
//   "user:you@example.com",
// ]

// Restricts which repository's GitHub Actions may impersonate the deploy service account.
// github_repository = "eagapov-dev/roomlock"

// TRUE guards Cloud SQL, Kafka, the Cloud Run services and the password secret against destroy, and
// also keeps the Cloud SQL backups after the instance is deleted. Leave it false for a deployment you
// intend to tear down the same day.
// deletion_protection = false
