# Local docker-compose settings. Copy to infra/.env (git-ignored) and adjust if a port is taken:
#   cp infra/.env.example infra/.env
# Every value has the same default in docker-compose.yml, so the stack also starts without .env.
# Credentials below are for the local throwaway stack only; never reuse them anywhere else.

# Host ports (container ports are fixed). 5432 and 8080 are often taken on dev machines,
# hence the non-standard defaults.
POSTGRES_PORT=5433
KAFKA_PORT=9094
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
BOOKING_PORT=8090
PAYMENT_PORT=8091
PAYMENT_GRPC_PORT=9091
NOTIFICATION_PORT=8092

# Locking strategy booking-service runs with: pessimistic | optimistic | constraint.
ROOMLOCK_LOCKING_STRATEGY=constraint

# Local-only credentials.
POSTGRES_SUPERUSER_PASSWORD=postgres
ROOMLOCK_DB_USER=roomlock
ROOMLOCK_DB_PASSWORD=roomlock
GRAFANA_ADMIN_PASSWORD=admin
