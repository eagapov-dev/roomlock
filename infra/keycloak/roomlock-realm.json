{
  "realm": "roomlock",
  "displayName": "RoomLock (local only, throwaway credentials)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "clientScopes": [
    {
      "name": "basic",
      "description": "The subject claim. Naming clientScopes at all replaces the ones Keycloak would create, so the scope that carries `sub` has to be spelled out here - a token without a subject has no guest.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "catalog:write",
      "description": "Create a hotel and add rooms to it. An operator action, not a guest one.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "roomlock-guest",
      "name": "RoomLock guest",
      "description": "A guest of the booking API: holds a room, pays for it, cancels it. Public client with direct access grants, and deliberately without catalog:write.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    },
    {
      "clientId": "roomlock-operator",
      "name": "RoomLock operator",
      "description": "Writes the catalog, and the client the Gatling simulations authenticate as. Its service account is also a guest, because a load run needs the scope to build its fixture and a subject to book with, in one token.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "roomlock-operator-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "catalog:write"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "guest",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Guest",
      "email": "guest@roomlock.test",
      "credentials": [
        {
          "type": "password",
          "value": "guest",
          "temporary": false
        }
      ]
    }
  ]
}
